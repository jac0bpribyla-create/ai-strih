#!/bin/bash
# Python s mlx_whisper a numpy pro skripty skillu: scripts/py scripts/<skript>.py …
# Pořadí: "python" z nastaveni.json → nástroj uv mlx-whisper → chyba s návodem.
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$(/usr/bin/python3 "$DIR/nastaveni.py" python 2>/dev/null)"
if [ -z "$PY" ] && command -v uv >/dev/null 2>&1; then
  PY="$(uv tool dir 2>/dev/null)/mlx-whisper/bin/python"
fi
PY="${PY/#\~/$HOME}"
if [ ! -x "$PY" ]; then
  echo "Chybí Python s mlx_whisper. Nainstaluj: uv tool install mlx-whisper --with numpy (viz INSTALL.md, krok 3)." >&2
  exit 1
fi
exec "$PY" "$@"
