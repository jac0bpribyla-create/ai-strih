#!/usr/bin/env bash
# Python s Whisperem a numpy pro skripty skillu: scripts/py scripts/<skript>.py … (Mac i Windows v Git Bash)
# Pořadí: "python" z nastaveni.json → ~/AI-strih/nastroje/python (venv) → nástroj uv mlx-whisper → chyba s návodem.
export PYTHONUTF8=1  # Windows: soubory i výpis v UTF-8 (čeština, ✓)
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$(sed -n 's/.*"python"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/../nastaveni.json" 2>/dev/null | head -n 1)"
PY="${PY/#\~/$HOME}"
UV_TOOL="$(uv tool dir 2>/dev/null)"
for k in "$PY" "$HOME/AI-strih/nastroje/python/bin/python" "$HOME/AI-strih/nastroje/python/Scripts/python.exe" \
         "${UV_TOOL:+$UV_TOOL/mlx-whisper/bin/python}"; do
  if [ -n "$k" ] && [ -x "$k" ]; then
    exec "$k" "$@"
  fi
done
echo "Chybí Python s Whisperem a numpy. Nainstaluj ho podle INSTALL.md, krok 3." >&2
exit 1
